  <joint
    name="joint2"
    type="revolute">
    <!-- Mode-0 controller/FK offset. Do not add the optional SDK mode-1
         two-degree J2/J3 correction to the robot_state_publisher model. -->
    <origin
      xyz="0 0 0"
      rpy="1.5707963267948966 -0.10088003076527219 -3.141592653589793" />
    <parent
      link="link1" />
    <child
      link="link2" />
    <axis
      xyz="0 0 1" />
    <!-- Admit the measured disabled gravity-droop start for collision-checked
         bootstrap recovery. Powered command targets are separately restricted
         to controller-representable J2 >= 0. -->
    <limit
      lower="-0.044796192"
      upper="3.14"
      effort="100"
      velocity="5" />
  </joint>
