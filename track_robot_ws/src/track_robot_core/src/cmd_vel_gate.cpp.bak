#include <algorithm>
#include <chrono>
#include <memory>

#include "rclcpp/rclcpp.hpp"
#include "geometry_msgs/msg/twist.hpp"

using namespace std::chrono_literals;

class CmdVelGate : public rclcpp::Node
{
public:
  CmdVelGate()
  : Node("cmd_vel_gate")
  {
    // ---- 参数（可在 launch 或命令行覆盖）----
    this->declare_parameter<std::string>("input_topic", "/cmd_vel");
    this->declare_parameter<std::string>("output_topic", "/bunker/cmd_vel");
    this->declare_parameter<double>("max_linear_x", 0.8);     // m/s
    this->declare_parameter<double>("max_angular_z", 1.2);    // rad/s
    this->declare_parameter<double>("timeout_sec", 0.3);      // 超时刹车

    input_topic_  = this->get_parameter("input_topic").as_string();
    output_topic_ = this->get_parameter("output_topic").as_string();
    max_linear_x_ = this->get_parameter("max_linear_x").as_double();
    max_angular_z_= this->get_parameter("max_angular_z").as_double();
    timeout_sec_  = this->get_parameter("timeout_sec").as_double();

    // ---- Publisher ----
    pub_ = this->create_publisher<geometry_msgs::msg::Twist>(output_topic_, 10);

    // ---- Subscriber ----
    sub_ = this->create_subscription<geometry_msgs::msg::Twist>(
      input_topic_,
      10,
      std::bind(&CmdVelGate::on_cmd_vel, this, std::placeholders::_1)
    );

    last_rx_time_ = this->now();

    // 定时器：检查超时，超时就发 0
    timer_ = this->create_wall_timer(50ms, std::bind(&CmdVelGate::on_timer, this));

    RCLCPP_INFO(this->get_logger(),
      "cmd_vel_gate started. sub: %s  pub: %s  vmax: %.2f wmax: %.2f timeout: %.2fs",
      input_topic_.c_str(), output_topic_.c_str(), max_linear_x_, max_angular_z_, timeout_sec_);
  }

private:
  void on_cmd_vel(const geometry_msgs::msg::Twist::SharedPtr msg)
  {
    last_rx_time_ = this->now();

    geometry_msgs::msg::Twist out = *msg;

    // 限幅（只做 x 和 z，底盘一般只用这两个）
    out.linear.x  = std::max(-max_linear_x_,  std::min(out.linear.x,  max_linear_x_));
    out.angular.z = std::max(-max_angular_z_, std::min(out.angular.z, max_angular_z_));
    pub_->publish(out);
  }

  void on_timer()
  {
    const double dt = (this->now() - last_rx_time_).seconds();
    if (dt > timeout_sec_) {
      geometry_msgs::msg::Twist stop;
      pub_->publish(stop);
    }
  }

  std::string input_topic_;
  std::string output_topic_;
  double max_linear_x_;
  double max_angular_z_;
  double timeout_sec_;

  rclcpp::Time last_rx_time_;
  rclcpp::Publisher<geometry_msgs::msg::Twist>::SharedPtr pub_;
  rclcpp::Subscription<geometry_msgs::msg::Twist>::SharedPtr sub_;
  rclcpp::TimerBase::SharedPtr timer_;
};

int main(int argc, char ** argv)
{
  rclcpp::init(argc, argv);
  rclcpp::spin(std::make_shared<CmdVelGate>());
  rclcpp::shutdown();
  return 0;
}

