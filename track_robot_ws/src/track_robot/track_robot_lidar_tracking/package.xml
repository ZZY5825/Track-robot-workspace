<?xml version="1.0"?>
<package format="3">
  <name>track_robot_lidar_tracking</name>
  <version>0.0.1</version>
  <description>C++ LiDAR tracklet manager for Track Robot human-following perception.</description>

  <maintainer email="track-robot@example.com">track-robot</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>visualization_msgs</depend>
  <depend>tf2_ros</depend>
  <depend>track_robot_interfaces</depend>

  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
