Panels:
  - Class: rviz_common/Displays
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /Global Options1
        - /Semantic Candidate Overlay1
      Splitter Ratio: 0.5
    Tree Height: 420
  - Class: track_robot_semantic_search_rviz_plugins/SemanticSearchPanel
    Name: Semantic Search
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Enabled: true
      Name: Camera Reference Grid
      Plane: XY
      Value: true
    - Class: rviz_default_plugins/TF
      Enabled: true
      Frame Timeout: 15
      Name: TF
      Show Axes: true
      Show Names: false
      Value: true
    - Class: rviz_default_plugins/Image
      Enabled: true
      Name: Semantic Candidate Overlay
      Normalize Range: true
      Topic:
        Value: /semantic_search/overlay_image
      Value: true
  Enabled: true
  Global Options:
    Background Color: 32; 34; 38
    Fixed Frame: zed_left_camera_optical_frame
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 3
      Focal Point:
        X: 0
        Y: 0
        Z: 1
      Name: Current View
      Pitch: 0.5
      Target Frame: zed_left_camera_optical_frame
      Yaw: 0.5
Window Geometry:
  Height: 900
  Width: 1500
