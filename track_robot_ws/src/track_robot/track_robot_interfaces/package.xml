<?xml version="1.0"?>
<package format="3">
  <name>track_robot_interfaces</name>
  <version>0.0.1</version>
  <description>Interfaces (msg/srv/action) for Track Robot.</description>

  <maintainer email="TODO@TODO.com">TODO</maintainer>
  <license>TODO</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <!-- 之后加 msg/srv/action 时需要 -->
  <build_depend>rosidl_default_generators</build_depend>
  <exec_depend>rosidl_default_runtime</exec_depend>

  <!-- 如果你要用 builtin_interfaces/Header 之类常见接口，也会用到 -->
  <depend>builtin_interfaces</depend>
  <depend>std_msgs</depend>
  <depend>geometry_msgs</depend>

  <member_of_group>rosidl_interface_packages</member_of_group>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
