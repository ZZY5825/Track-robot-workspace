<?xml version="1.0"?>
<package format="3">
  <name>track_robot_semantic_memory</name>
  <version>0.1.0</version>
  <description>Bounded C++ multi-object semantic memory for Track Robot.</description>

  <maintainer email="track-robot@example.com">track-robot</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <build_depend>nlohmann-json3-dev</build_depend>

  <depend>rclcpp</depend>
  <depend>ament_index_cpp</depend>
  <depend>tf2_ros</depend>
  <depend>geometry_msgs</depend>
  <depend>std_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>visualization_msgs</depend>
  <depend>diagnostic_msgs</depend>
  <depend>track_robot_interfaces</depend>

  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <test_depend>ament_cmake_gtest</test_depend>
  <test_depend>ament_cmake_pytest</test_depend>
  <test_depend>python3-yaml</test_depend>
  <test_depend>ament-index-python</test_depend>
  <test_depend>rclpy</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
