Panels:
  - Class: rviz_common/Displays
    Help Height: 78
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /Global Options1
        - /Status1
      Splitter Ratio: 0.5
    Tree Height: 520
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Enabled: true
      Name: Grid
      Plane: XY
      Value: true
    - Class: rviz_default_plugins/PointCloud2
      Enabled: true
      Name: RoboSense Points
      Topic:
        Value: /rslidar_points
      Value: true
    - Class: rviz_default_plugins/MarkerArray
      Enabled: true
      Name: LiDAR Candidate Clusters
      Topic:
        Value: /human_tracking/lidar_candidate_cluster_markers
      Value: true
    - Class: rviz_default_plugins/MarkerArray
      Enabled: true
      Name: LiDAR Tracklets
      Topic:
        Value: /human_tracking/lidar_tracklet_markers
      Value: true
    - Class: rviz_default_plugins/MarkerArray
      Enabled: true
      Name: Selected Tracklet
      Topic:
        Value: /human_tracking/selected_tracklet_marker
      Value: true
    - Class: rviz_default_plugins/MarkerArray
      Enabled: true
      Name: Selected Target
      Topic:
        Value: /human_tracking/selected_target_marker
      Value: true
    - Class: rviz_default_plugins/MarkerArray
      Enabled: true
      Name: Prediction Gate
      Topic:
        Value: /human_tracking/target_prediction_gate_marker
      Value: true
    - Class: rviz_default_plugins/MarkerArray
      Enabled: true
      Name: Association Hypotheses
      Topic:
        Value: /human_tracking/association_hypothesis_markers
      Value: true
    - Class: rviz_default_plugins/PointCloud2
      Enabled: true
      Name: Camera Guided Target Points
      Topic:
        Value: /human_tracking/camera_guided_target_points
      Value: true
    - Class: rviz_default_plugins/MarkerArray
      Enabled: true
      Name: Target Marker
      Topic:
        Value: /human_tracking/fused_target_marker
      Value: true
    - Class: rviz_default_plugins/MarkerArray
      Enabled: true
      Name: Follow Decision
      Topic:
        Value: /follow/decision_markers
      Value: true
    - Class: rviz_default_plugins/MarkerArray
      Enabled: true
      Name: Follow Controller
      Topic:
        Value: /follow/controller_markers
      Value: true
    - Class: rviz_default_plugins/Image
      Enabled: true
      Name: Target Overlay
      Topic:
        Value: /human_tracking/target_overlay
      Value: true
  Enabled: true
  Global Options:
    Fixed Frame: base_link
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 12
      Focal Point:
        X: 0
        Y: 0
        Z: 0
      Name: Current View
      Pitch: 0.785
      Target Frame: base_link
      Yaw: 0.785
Window Geometry:
  Height: 900
  Width: 1400
